# =============================================================================
# SCOPE Environment Variables
# =============================================================================
# This example file contains ONLY:
# - Secrets (API keys, passwords)
# - Settings without CLI equivalents
#
# For all available configuration options, see: scope/config.py
# Most settings can be passed via CLI arguments (run: uv run scope --help)
# If you need to fix anything for all your runs, simply create a new entry in the .env file.
# The default values in scope/config.py should be resepected and remain unchanged.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Jina AI API Key (get free key at: https://jina.ai/?sui=apikey)
JINA_API_KEY=your_api_key_here

# PostgreSQL password (if using PostgreSQL)
DATABASE_PASSWORD=

# -----------------------------------------------------------------------------
# Commonly Used Settings (can also be passed via CLI)
# -----------------------------------------------------------------------------
# Embedding provider: "sentence-transformers" or "jina" (recommended)
SCOPE_EMBEDDING_PROVIDER=jina

# Probability threshold for topic matching (0.0-1.0)
SCOPE_PROBABILITY_THRESHOLD=0.06

# -----------------------------------------------------------------------------
# Settings Without CLI Equivalents
# -----------------------------------------------------------------------------
# Path to labeled test data for evaluation accuracy
SCOPE_LABELED_TEST_DATA=data/labeled_test_data_clean.csv

# -----------------------------------------------------------------------------
# PostgreSQL Connection (if using --use-postgres)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scope
DATABASE_USER=postgres
