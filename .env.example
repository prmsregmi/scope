# =============================================================================
# SCOPE Configuration via Environment Variables
# =============================================================================
# Copy this file to .env and configure your settings
# Priority: CLI arguments > .env values > Python defaults

# -----------------------------------------------------------------------------
# API Keys (Required for cloud providers)
# -----------------------------------------------------------------------------
# Jina AI API Key - Get your free key at: https://jina.ai/?sui=apikey
JINA_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Embedding Configuration (Optional - override defaults)
# -----------------------------------------------------------------------------
# Embedding provider: "sentence-transformers" (local) or "jina" (API)
SCOPE_EMBEDDING_PROVIDER=sentence-transformers

# Embedding model name (provider-specific)
# SentenceTransformers: all-MiniLM-L12-v2, all-mpnet-base-v2, etc.
# Jina: jina-embeddings-v3, jina-embeddings-v2
# SCOPE_EMBEDDING_MODEL=all-MiniLM-L12-v2

# KeyBERT model for keyword extraction
# SCOPE_KEYBERT_MODEL=all-MiniLM-L12-v2

# -----------------------------------------------------------------------------
# Data Configuration (Optional)
# -----------------------------------------------------------------------------
# Default dataset path
SCOPE_DATASET_PATH=data/Conversation.csv

# -----------------------------------------------------------------------------
# Analysis Configuration (Optional)
# -----------------------------------------------------------------------------
# Probability threshold for contiguous block detection (0.0-1.0)
# Higher = stricter matching, Lower = more segments
# SCOPE_PROBABILITY_THRESHOLD=0.07

# Default output path for results
# SCOPE_OUTPUT_PATH=results/scope_results.csv

# -----------------------------------------------------------------------------
# Preprocessing Options (Optional)
# -----------------------------------------------------------------------------
# Enable spell checking (true/false)
# SCOPE_SPELL_CHECK=true

# Enable lemmatization (true/false)
# SCOPE_LEMMATIZE=true

# -----------------------------------------------------------------------------
# Evaluation Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable evaluation mode (collects performance & accuracy metrics)
SCOPE_ENABLE_EVALUATION=true

# Path to labeled test data for accuracy calculation
SCOPE_LABELED_TEST_DATA=data/labeled_test_data_clean.csv

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Optional - for pgvector similarity search)
# -----------------------------------------------------------------------------
# Requires: uv sync --extra postgres (or pip install 'scope[postgres]')
# Provides 8-10x speedup with cached embeddings!

# Enable PostgreSQL vector storage
SCOPE_USE_POSTGRES=false

# PostgreSQL connection settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scope
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Alternative: Use DATABASE_URL instead of individual settings
# DATABASE_URL=postgresql://user:password@localhost:5432/scope

# PostgreSQL Vector Index Settings (Advanced)
# SCOPE_INDEX_TYPE=hnsw  # or ivfflat
# SCOPE_EMBEDDING_DIM=384  # 384 for MiniLM, 1024 for Jina
# SCOPE_HNSW_M=16
# SCOPE_HNSW_EF_CONSTRUCTION=64
# SCOPE_IVFFLAT_LISTS=100

# Quick Start with PostgreSQL:
# 1. Install: uv sync --extra postgres
# 2. Start PostgreSQL: docker run -d -p 5432:5432 -e POSTGRES_DB=scope ankane/pgvector
# 3. Set SCOPE_USE_POSTGRES=true
# 4. Run: scope data.csv (will auto-create schema)
